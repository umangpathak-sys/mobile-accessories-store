<%- include('partials/head') %>

<section class="hero">
  <h1>Accessories for every phone you own</h1>
  <p>Cases, chargers, audio and mounts, filtered to fit your exact Apple or Android device.</p>
</section>

<form class="filters" method="get" action="/">
  <label>
    Platform
    <select name="platform" onchange="this.form.device.value=''; this.form.submit()">
      <option value="">All platforms</option>
      <% platforms.forEach(function (p) { %>
        <option value="<%= p.id %>" <%= filters.platform === p.id ? 'selected' : '' %>><%= p.name %></option>
      <% }) %>
    </select>
  </label>
  <label>
    Device
    <select name="device" data-testid="device-filter" onchange="this.form.submit()">
      <option value="">All devices</option>
      <% devices.forEach(function (d) { %>
        <option value="<%= d.id %>" <%= filters.device === d.id ? 'selected' : '' %>><%= d.name %></option>
      <% }) %>
    </select>
  </label>
  <label>
    Category
    <select name="category" onchange="this.form.submit()">
      <option value="">All categories</option>
      <% categories.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= filters.category === c.id ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
  </label>
  <label>
    Brand
    <select name="brand" onchange="this.form.submit()">
      <option value="">All brands</option>
      <% brands.forEach(function (b) { %>
        <option value="<%= b %>" <%= filters.brand === b ? 'selected' : '' %>><%= b %></option>
      <% }) %>
    </select>
  </label>
  <label>
    Sort
    <select name="sort" onchange="this.form.submit()">
      <option value="featured" <%= filters.sort === 'featured' ? 'selected' : '' %>>Featured</option>
      <option value="price-asc" <%= filters.sort === 'price-asc' ? 'selected' : '' %>>Price: low to high</option>
      <option value="price-desc" <%= filters.sort === 'price-desc' ? 'selected' : '' %>>Price: high to low</option>
      <option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Top rated</option>
    </select>
  </label>
  <input type="hidden" name="search" value="<%= filters.search %>">
  <noscript><button type="submit">Apply</button></noscript>
</form>

<p class="result-count" data-testid="result-count"><%= products.length %> product<%= products.length === 1 ? '' : 's' %></p>

<% if (products.length === 0) { %>
  <p class="empty">No accessories match those filters yet. Try clearing the device or category filter.</p>
<% } %>

<ul class="grid">
  <% products.forEach(function (p) { %>
    <li class="card" data-testid="product-card">
      <a href="/products/<%= p.id %><%= filters.device ? '?device=' + filters.device : '' %>">
        <img src="<%= p.image %>" alt="<%= p.name %>">
        <h2><%= p.name %></h2>
      </a>
      <p class="brand"><%= p.brand %> · ★ <%= p.rating.toFixed(1) %></p>
      <p class="desc"><%= p.description %></p>
      <p class="price">From <%= currency(p.basePrice) %></p>
      <a class="button" href="/products/<%= p.id %><%= filters.device ? '?device=' + filters.device : '' %>">Configure</a>
    </li>
  <% }) %>
</ul>

<%- include('partials/foot') %>
