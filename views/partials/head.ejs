<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Mobile Accessories</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/">mobile<span>accessories</span></a>
    <form class="search" action="/" method="get">
      <input type="search" name="search" placeholder="Search cases, chargers, audio…" value="<%= (query && query.search) || '' %>">
      <button type="submit">Search</button>
    </form>
    <a class="cart-link" href="/cart" data-testid="cart-link">Cart<span class="badge" data-testid="cart-count"><%= cartCount %></span></a>
  </div>
  <nav class="wrap subnav">
    <a href="/">All</a>
    <% platforms.forEach(function (p) { %>
      <a href="/?platform=<%= p.id %>"><%= p.name %></a>
    <% }) %>
    <% categories.forEach(function (c) { %>
      <a href="/?category=<%= c.id %>"><%= c.name %></a>
    <% }) %>
  </nav>
</header>
<main class="wrap">
