<%- include('partials/head') %>

<h1>Checkout</h1>

<div class="cart-layout">
  <form method="post" action="/checkout" class="checkout-form">
    <input type="hidden" name="shipping" value="<%= shipping %>">

    <h2>Shipping details</h2>
    <label class="field">Full name
      <input name="fullName" value="<%= form.fullName || '' %>" data-testid="fullName">
      <% if (errors.fullName) { %><span class="error"><%= errors.fullName %></span><% } %>
    </label>
    <label class="field">Email
      <input name="email" value="<%= form.email || '' %>" data-testid="email">
      <% if (errors.email) { %><span class="error"><%= errors.email %></span><% } %>
    </label>
    <label class="field">Address
      <input name="address1" value="<%= form.address1 || '' %>" data-testid="address1">
      <% if (errors.address1) { %><span class="error"><%= errors.address1 %></span><% } %>
    </label>
    <label class="field">Apartment, suite (optional)
      <input name="address2" value="<%= form.address2 || '' %>" data-testid="address2">
    </label>
    <div class="row">
      <label class="field">City
        <input name="city" value="<%= form.city || '' %>" data-testid="city">
        <% if (errors.city) { %><span class="error"><%= errors.city %></span><% } %>
      </label>
      <label class="field">Postal code
        <input name="postalCode" value="<%= form.postalCode || '' %>" data-testid="postalCode">
        <% if (errors.postalCode) { %><span class="error"><%= errors.postalCode %></span><% } %>
      </label>
      <label class="field">Country
        <input name="country" value="<%= form.country || '' %>" data-testid="country">
        <% if (errors.country) { %><span class="error"><%= errors.country %></span><% } %>
      </label>
    </div>

    <h2>Payment</h2>
    <p class="hint">Demo checkout — use test card 4242 4242 4242 4242.</p>
    <label class="field">Card number
      <input name="cardNumber" value="<%= form.cardNumber || '' %>" data-testid="cardNumber" autocomplete="off">
      <% if (errors.cardNumber) { %><span class="error"><%= errors.cardNumber %></span><% } %>
    </label>
    <div class="row">
      <label class="field">Expiry (MM/YY)
        <input name="cardExpiry" value="<%= form.cardExpiry || '' %>" data-testid="cardExpiry" autocomplete="off">
        <% if (errors.cardExpiry) { %><span class="error"><%= errors.cardExpiry %></span><% } %>
      </label>
      <label class="field">Security code
        <input name="cardCvc" value="<%= form.cardCvc || '' %>" data-testid="cardCvc" autocomplete="off">
        <% if (errors.cardCvc) { %><span class="error"><%= errors.cardCvc %></span><% } %>
      </label>
    </div>

    <button class="button primary" type="submit" data-testid="place-order">Place order · <%= currency(totals.total) %></button>
  </form>

  <aside class="summary">
    <h2>Order summary</h2>
    <ul class="mini-items">
      <% cart.forEach(function (line) { %>
        <li><%= line.quantity %> × <%= line.productName %> <span class="meta">(<%= line.deviceName %>)</span>
          <strong><%= currency(line.unitPrice * line.quantity) %></strong></li>
      <% }) %>
    </ul>
    <%- include('partials/totals', { totals: totals }) %>
    <a href="/cart">Edit cart</a>
  </aside>
</div>

<%- include('partials/foot') %>
